# Music21 MCP Server — Environment Variables
# Copy to .env and adjust as needed.

# Server host and port (HTTP adapter and launcher)
MUSIC21_MCP_HOST=127.0.0.1
MUSIC21_MCP_PORT=8000

# Operation timeouts (seconds)
MUSIC21_MCP_TIMEOUT=30
MUSIC21_TOOL_TIMEOUT=30
MUSIC21_CHORD_ANALYSIS_TIMEOUT=60
MUSIC21_BATCH_TIMEOUT=30

# CORS origins for HTTP adapter (comma-separated)
MUSIC21_CORS_ORIGINS=http://localhost:*
